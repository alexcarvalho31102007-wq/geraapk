# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GITHUB_TOKEN: Personal Access Token (Fine-Grained or Classic with repo & workflow scopes) for GitHub Actions API compilation.
GITHUB_TOKEN=YOUR_GITHUB_PAT_HERE

# SUPABASE_URL: URL do projeto Supabase (ex: https://xyzcompany.supabase.co) configurado no painel Secrets do AI Studio.
SUPABASE_URL=YOUR_SUPABASE_URL_HERE

# SUPABASE_ANON_KEY: Chave pública anônima (anon/public key) do Supabase com RLS habilitado.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

